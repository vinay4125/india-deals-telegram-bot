# Required for posting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Deal selection
MIN_DISCOUNT_PERCENT=30
FLASH_DEAL_MAX_PRICE=10
MAX_DEALS_PER_RUN=10
# Leave empty to include every category.
DEAL_KEYWORDS=
STATE_FILE=.deals-state.json
STATE_RETENTION_DAYS=14
DRY_RUN=false

# Amazon India Creators API (optional)
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_ASSOCIATE_TAG=
AMAZON_SEARCH_KEYWORDS=smartphone,laptop,headphones,television,appliances
AMAZON_TOKEN_URL=https://api.amazon.co.uk/auth/o2/token
AMAZON_API_URL=https://creatorsapi.amazon/searchItems

# Flipkart Affiliate API (optional)
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
FLIPKART_CATEGORIES=mobiles,laptops,televisions,home-appliances

# Comma-separated HTTPS endpoints returning the documented JSON schema (optional)
JSON_FEED_URLS=
